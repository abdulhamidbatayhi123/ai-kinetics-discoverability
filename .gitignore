paper2/*.out

# Run-time logs of the grid chain (the results files are the record)
p2_grid_chain.log
paper2/stage1.log

# Personal, never public
outreach/
USER_ACTIONS.md

# Packaging and scratch
submission/
*.zip
results/tmp*.tmp
Thumbs.db
.DS_Store
